# =============================================================================
# RAMP — Regime-Aware Mixture-of-Experts Post-Processor
# SIH26080 | Production & Development Environment Example
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# =============================================================================

# Application Settings
APP_NAME=RAMP-MoES-NCMRWF
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=changeme-in-production-use-a-secure-random-secret-key-min-32-chars

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Data Mode: SYNTHETIC_DEMO | REAL
# In Phase 1, default is SYNTHETIC_DEMO. Do NOT fabricate fake ML predictions.
RAMP_DATA_MODE=SYNTHETIC_DEMO

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://ramp:ramp@localhost:5432/ramp_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Cache & Task Broker
REDIS_URL=redis://localhost:6379/0

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=ramp_experiments

# Data Directories
RAMP_DATA_ROOT=./data
RAMP_CONFIG_PATH=./config/model_config.yaml

# Frontend Environment (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE="RAMP | MoES-NCMRWF Monsoon Forecast Post-Processing"
