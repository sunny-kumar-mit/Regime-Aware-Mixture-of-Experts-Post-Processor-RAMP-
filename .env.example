# =============================================================================
# RAMP — Regime-Aware Mixture-of-Experts Post-Processor
# SIH26080 | Production & Development Environment Example
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# =============================================================================

# Frontend Public Map Configuration (MapLibre GL JS / Leaflet)
# PUBLIC VARIABLES ONLY (Exposed to the browser via VITE_*)
# Keyless public basemap providers (CartoDB / OpenStreetMap) require NO secret API key.
VITE_MAP_PROVIDER=maplibre
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
VITE_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors &copy; CARTO"
VITE_MAP_API_KEY=

# Application & API URLs
VITE_API_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE="RAMP | MoES-NCMRWF Monsoon Forecast Post-Processing"

# Backend Core Settings (SERVER-SIDE ONLY - NEVER EXPOSE TO FRONTEND)
APP_NAME=RAMP-MoES-NCMRWF
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=changeme-in-production-use-a-secure-random-secret-key-min-32-chars

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Operational Data Mode: SYNTHETIC_DEMO | REAL_OPERATIONAL | REAL_DATA_EXPERIMENT
RAMP_DATA_MODE=REAL_OPERATIONAL

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql+asyncpg://ramp:ramp@localhost:5432/ramp_db
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=placeholder_server_only_secret_do_not_expose_to_frontend

# Object Storage Backend: MINIO | LOCAL_FALLBACK
STORAGE_MODE=MINIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin12345
MINIO_BUCKET=ramp-meteorological-vault

# Meteorological Institutional Sources (Official MoES Portals)
NCMRWF_BASE_URL=https://nwp.ncmrwf.gov.in
IMD_BASE_URL=https://www.imdpune.gov.in

# Local Data Vault Directory & Model Paths
RAMP_DATA_ROOT=./data
RAMP_CONFIG_PATH=./config/model_config.yaml
