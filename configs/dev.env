# =============================================================================
# RAMP — Regime-Aware Mixture-of-Experts Post-Processor
# Development Environment Template
# SIH26080 | configs/dev.env
#
# INSTRUCTIONS:
#   1. Copy this file to the repo root: cp configs/dev.env .env
#   2. Fill in the values marked <FILL_IN> with your local credentials.
#   3. NEVER commit the filled-in .env file — it is in .gitignore.
#   4. This template (configs/dev.env) is safe to commit: it contains NO secrets.
#
# DataMode: SYNTHETIC_DEMO is the default here.
# Override RAMP_DATA_MODE=REAL only when connecting to actual NWP/obs feeds.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
DEBUG=true
LOG_LEVEL=DEBUG

# ---------------------------------------------------------------------------
# Data Mode — CRITICAL
# SYNTHETIC_DEMO = generated data, safe for demos, NOT for operations
# REAL           = live/historical NWP + IMD observations
# ---------------------------------------------------------------------------
RAMP_DATA_MODE=SYNTHETIC_DEMO

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://ramp:ramp@localhost:5432/ramp_dev
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
# Test database (used by pytest)
TEST_DATABASE_URL=postgresql://ramp:ramp@localhost:5432/ramp_test

# ---------------------------------------------------------------------------
# MLflow Tracking
# ---------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=ramp_dev
# Set to a local path if not using remote artifact store
MLFLOW_ARTIFACT_ROOT=./mlflow/mlartifacts

# ---------------------------------------------------------------------------
# Redis (task queue / caching)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# CHANGE THIS before any deployment — any string ≥ 32 chars works for dev
SECRET_KEY=changeme-replace-with-a-long-random-string-in-production
API_KEY_HEADER=X-RAMP-API-Key
# Set to a real key for protected endpoints; leave empty to disable auth in dev
RAMP_API_KEY=

# ---------------------------------------------------------------------------
# Data Paths (local dev — override with object-storage URLs in prod)
# ---------------------------------------------------------------------------
RAMP_DATA_ROOT=./data
RAMP_RAW_DATA_DIR=./data/raw
RAMP_PROCESSED_DATA_DIR=./data/processed
RAMP_SHAPEFILES_DIR=./data/shapefiles
RAMP_DEM_DIR=./data/dem

# ---------------------------------------------------------------------------
# Model Artefact Paths
# ---------------------------------------------------------------------------
RAMP_MODEL_CONFIG=./configs/model_config.yaml
# Where trained model binaries are saved (outside MLflow, for fast loading)
RAMP_MODEL_CACHE_DIR=./ml/trained_models

# ---------------------------------------------------------------------------
# NWP Data Sources (fill in when connecting to real feeds)
# ---------------------------------------------------------------------------
# NCMRWF NCUM/NEPS — local path or SFTP/S3 URL
NCUM_DATA_PATH=<FILL_IN>
NEPS_DATA_PATH=<FILL_IN>
# NOAA GFS/GEFS — S3 bucket or local mirror
GFS_DATA_PATH=<FILL_IN>
GEFS_DATA_PATH=<FILL_IN>
# IMD Gridded Observations
IMD_OBS_PATH=<FILL_IN>

# ---------------------------------------------------------------------------
# Observational Data (IMD API — optional)
# ---------------------------------------------------------------------------
IMD_API_BASE_URL=<FILL_IN>
IMD_API_KEY=<FILL_IN>

# ---------------------------------------------------------------------------
# Frontend (Vite dev server)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_MLFLOW_URL=http://localhost:5000
VITE_DATA_MODE=SYNTHETIC_DEMO

# ---------------------------------------------------------------------------
# Docker Compose Overrides (used when running via docker-compose)
# ---------------------------------------------------------------------------
POSTGRES_USER=ramp
POSTGRES_PASSWORD=ramp
POSTGRES_DB=ramp_dev
