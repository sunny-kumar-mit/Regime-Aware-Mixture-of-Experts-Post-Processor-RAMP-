# RAMP Staging Environment Template
# SIH26080 | MoES / NCMRWF
APP_ENV=STAGING
RAMP_DATA_MODE=STAGING_REAL_DATA
ENABLE_STAGING_MODE=1
REQUIRE_AUTHORITATIVE_MOUNT=0

NCMRWF_DATA_ROOT=/data/ncmrwf_staging
IMD_DATA_ROOT=/data/imd_staging
MODEL_REGISTRY_ROOT=ml/model_registry
FORECAST_OUTPUT_ROOT=data/processed/forecasts/staging
AUDIT_ROOT=data/audit
LOG_ROOT=data/logs

APP_HOST=0.0.0.0
APP_PORT=8001
SECRET_KEY=staging-key-for-institutional-validation-min-32-chars
