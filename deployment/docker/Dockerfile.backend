# Production Dockerfile for RAMP Backend API
# SIH26080 | MoES / NCMRWF
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for NetCDF, GRIB, and compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libnetcdf-dev \
    libhdf5-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source
COPY backend/ ./backend/
COPY ml/ ./ml/
COPY configs/ ./configs/
COPY deployment/ ./deployment/

ENV PYTHONPATH="/app:/app/backend/src"
ENV APP_ENV="PRODUCTION"
ENV RAMP_DATA_MODE="REAL_OPERATIONAL"

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health/live || exit 1

CMD ["uvicorn", "ramp.main:app", "--app-dir", "backend/src", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
