[Unit]
Description=RAMP Operational Backend API Service (MoES / NCMRWF)
After=network.target

[Service]
Type=simple
User=ramp
Group=ramp
WorkingDirectory=/opt/ramp
Environment="PATH=/opt/ramp/venv/bin"
EnvironmentFile=/etc/ramp/production.env
ExecStart=/opt/ramp/venv/bin/uvicorn ramp.main:app --app-dir backend/src --host 0.0.0.0 --port 8000 --workers 4
Restart=always
RestartSec=5s
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
