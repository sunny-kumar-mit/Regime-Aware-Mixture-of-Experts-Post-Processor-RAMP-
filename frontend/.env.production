# Frontend Production Configuration (Render & Production Deployments)
# Empty VITE_API_BASE_URL ensures all fetch calls use same-origin relative paths (/api/*)
VITE_MAP_PROVIDER=leaflet
VITE_MAP_STYLE_URL=https://services.arcgisonline.com/arcgis/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors &copy; Esri"
VITE_MAP_API_KEY=
VITE_API_URL=
VITE_API_BASE_URL=
VITE_APP_TITLE="RAMP | MoES-NCMRWF Monsoon Forecast Post-Processing"
