# Frontend Production Configuration (Render & Production Deployments)
# Empty VITE_API_BASE_URL ensures all fetch calls use same-origin relative paths (/api/*)
VITE_MAP_PROVIDER=maplibre
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
VITE_MAP_TILE_URL=https://a.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors &copy; CARTO"
VITE_MAP_API_KEY=
VITE_API_URL=
VITE_API_BASE_URL=
VITE_APP_TITLE="RAMP | MoES-NCMRWF Monsoon Forecast Post-Processing"
